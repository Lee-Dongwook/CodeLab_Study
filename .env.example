# 외부 데이터 제공처 연결 정보는 구현 단계에서 추가합니다.
# 실제 API 키, 토큰, 계정 정보는 이 파일에 작성하지 않습니다.
DART_API_KEY=your_opendart_api_key_here
KRX_API_KEY=your_krx_open_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# 공통 기본 모델. 전용 모델 변수가 없을 때 사용됩니다.
OPENAI_MODEL=gpt-4o-mini
# 선택값: 테마 후보 탐색에 사용할 모델
# OPENAI_MODEL보다 우선합니다.
OPENAI_THEME_MODEL=gpt-4o-mini
# 선택값: 미국 참고 정보 웹 검색에 사용할 모델
# OPENAI_MODEL보다 우선합니다.
OPENAI_REFERENCE_MODEL=gpt-4o-mini

# 프론트엔드에서 사용할 백엔드 주소입니다.
VITE_API_BASE_URL=http://localhost:8000
